# ============================================================
# SAMVAD SETU - PART B
# .gitignore
# ============================================================

# ------------------------------------------------------------
# Python Cache & Virtual Environments
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

venv/
env/
.venv/

# ------------------------------------------------------------
# Environment & Secrets (STRICTLY ONE MASTER .env in ai-engine/)
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# DATASETS (Ignore entire dataset directory & large assets)
# ------------------------------------------------------------
# Ignore entire dataset directories anywhere in part-b
dataset/
image/dataset/
**/dataset/

# Dataset archives and downloaded data dumps
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Dataset cache files and label caches
*.cache
labels.cache

# ------------------------------------------------------------
# YOLO TRAINING RUNS & OUTPUT WEIGHTS
# ------------------------------------------------------------
image/runs/
runs/
weights/
*.pt.backup

# ------------------------------------------------------------
# UPLOADED, GENERATED & LOCAL TEST IMAGES / AUDIO
# ------------------------------------------------------------
image/uploads/
voice/uploads/
uploads/
test_images/

# Local test images
image/test*.jpg
image/test*.jpeg
image/test*.png
image/test*.webp
*.tmp
*.temp

# ------------------------------------------------------------
# MODEL WEIGHTS (Only track production vision_model.pt)
# ------------------------------------------------------------
*.pt
!models/vision_model.pt
*.pth
*.onnx
*.engine

# ------------------------------------------------------------
# LOGS & SYSTEM ARTIFACTS
# ------------------------------------------------------------
*.log
logs/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*.bak
*.backup